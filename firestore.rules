rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // An admin is anyone holding the `admin` custom claim, which
    // /api/admin/firebase-token mints for the signed-in admin only.
    //
    // The bootstrap UID is accepted too, as belt-and-braces: it keeps the owner
    // able to reach the data if claim minting ever breaks.
    function isAdmin() {
      return request.auth != null
             && (request.auth.token.admin == true
                 || request.auth.uid == "kAT4ZuSCzGgTZ1RR85scNheVRrE3");
    }

    // Admins may READ anything — the dashboard's live listeners (orders,
    // driver, dashboard totals) need it.
    //
    // They may NOT write anything from the client. Every admin mutation already
    // goes through /api/admin/* on the Admin SDK, where the role checks live.
    // Granting client writes here would hand any admin a way around those
    // checks: with a broad `allow write` they could edit admins/{uid} straight
    // from the browser console and give themselves a role the server refuses.
    //
    // Note Firestore rules are OR'ed — a narrower rule cannot revoke a wider
    // grant — so this must never become `allow read, write`.
    match /{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Anyone can read services (public catalogue). Writes are Admin SDK only.
    match /services/{document=**} {
      allow read: if true;
    }

    // Orders — customers can read their own; all writes go through Admin SDK.
    match /orders/{orderId} {
      allow read: if isAdmin()
                  || (request.auth != null && resource.data.customerId == request.auth.uid);
    }

    // Customers can read and write their own profile (registration and saved
    // addresses are written from the client SDK). Nothing price-related is
    // trusted from here — see lib/first-time.ts.
    match /customers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
